# ═══════════════════════════════════════════════════════════════
#  MediVault — Environment Configuration
#  Copy this file to .env and fill in your values
#  Run:  copy .env.example .env
# ═══════════════════════════════════════════════════════════════

# ── SERVER ──────────────────────────────────────────────────────
PORT=3000

# ── GANACHE (Local Blockchain) ───────────────────────────────────
GANACHE_RPC_URL=http://127.0.0.1:7545
GANACHE_CHAIN_ID=1337

# ── SEPOLIA (Testnet) ────────────────────────────────────────────
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/alch_nxOJWzEQ-OZCh9ssWTK3k
SEPOLIA_CHAIN_ID=11155111

# MetaMask Private Key for Sepolia deployment
# Get from: MetaMask → Account → 3 dots → Account Details → Show Private Key
PRIVATE_KEY=0xYOUR_METAMASK_PRIVATE_KEY_HERE

# ── IPFS / PINATA ────────────────────────────────────────────────
PINATA_JWT=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..8HneMMaw_qwP1zU3ptAUQZfC8kNkBhwEfwkgCDyywJw
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/

# ── SMART CONTRACT ───────────────────────────────────────────────
# Auto-filled by deploy.js (Ganache)
GANACHE_CONTRACT_ADDRESS=0x482091b73484C94F7cC2Db30fA8Fa8c30801FE41

# Auto-filled by deploy-sepolia.js (Sepolia)
SEPOLIA_CONTRACT_ADDRESS=
